<%# pages/contact.ejs — კონტაქტის გვერდი -%>

<section class="page-banner" aria-label="გვერდის ერთაური">
  <div class="container page-banner-content">
    <nav aria-label="ნავიგაცია">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">მთავარი</a></li>
        <li class="breadcrumb-item active" aria-current="page">კონტაქტი</li>
      </ol>
    </nav>
    <h1 class="page-banner-title">დაგვიკავშირდით</h1>
    <p class="page-banner-subtitle">უჯარმის სოფლის ადმინისტრაციასთან დაკავშირდებით</p>
  </div>
</section>

<!-- Contact Section -->
<section class="section">
  <div class="container">

    <!-- ── Intro ────────────────────────────────────── -->
    <div class="row justify-content-center text-center mb-5 pb-2">
      <div class="col-lg-8">
        <div class="section-label" style="justify-content:center;">ადმინისტრაცია</div>
        <h2 class="mb-3">დაგვიკავშირდით</h2>
        <p class="contact-intro-text">
          უჯარმის სოფლის ადმინისტრაცია ღიაა ყველა მოსახლისთვის.
          გაქვთ კითხვა ინფრასტრუქტურის, საკადასტრო საკითხის,
          ტურისტული ინფორმაციის ან სოფლის ცხოვრებასთან
          დაკავშირებით? დაგვიკავშირდით ქვემოთ მითითებული
          საკონტაქტო ინფორმაციით.
        </p>
      </div>
    </div>

    <!-- ── Contact Information Cards ───────────────── -->
    <div class="row g-4 justify-content-center">
      <div class="col-lg-3 col-md-6">
        <div class="contact-card">
          <div class="contact-card-icon-wrap"><i data-lucide="map-pin"></i></div>
          <h3 class="contact-card-title">მისამართი</h3>
          <p class="contact-card-text">
            უჯარმის სოფელი<br />
            საგარეჯოს მუნიციპალიტეტი<br />
            კახეთის რეგიონი, საქართველო
          </p>
        </div>
      </div>

      <div class="col-lg-3 col-md-6">
        <div class="contact-card">
          <div class="contact-card-icon-wrap"><i data-lucide="phone"></i></div>
          <h3 class="contact-card-title">ტელეფონი</h3>
          <p class="contact-card-text">+995 (XXX) XXX-XXX</p>
        </div>
      </div>

      <div class="col-lg-3 col-md-6">
        <div class="contact-card">
          <div class="contact-card-icon-wrap"><i data-lucide="mail"></i></div>
          <h3 class="contact-card-title">ელ.ფოსტა</h3>
          <p class="contact-card-text">info@ujarma.ge</p>
        </div>
      </div>

      <div class="col-lg-3 col-md-6">
        <div class="contact-card">
          <div class="contact-card-icon-wrap"><i data-lucide="clock"></i></div>
          <h3 class="contact-card-title">სამუშაო საათები</h3>
          <p class="contact-card-text">
            ორშ – პარ: 09:00 – 18:00<br />
            შაბათი: 10:00 – 14:00<br />
            კვირა: დახურულია
          </p>
        </div>
      </div>
    </div>

  </div>
</section>
