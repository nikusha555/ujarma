<!-- ═══════════════════════════════════════════════════════
     FAQ — polished accordion
════════════════════════════════════════════════════════ -->
<section class="about-white-section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-9">

        <div class="text-center mb-5">
          <div class="section-label" style="justify-content:center;" data-i18n="about.faqSectionLabel">ხშირად დასმული კითხვები</div>
          <h2 class="about-section-heading mb-0" data-i18n="about.faqSectionTitle">FAQ</h2>
        </div>

        <% const faqs = [
          { q: 'სად მდებარეობს უჯარმა?', a: 'უჯარმა მდებარეობს საქართველოს კახეთის რეგიონში, საგარეჯოს მუნიციპალიტეტში, თბილისიდან დაახლოებით 60–65 კილომეტრის დაშორებით. ავტომობილით მგზავრობა დედაქალაქიდან ერთ საათამდე მიდის.', key: 'faq1' },
          { q: 'როდის იყო აშენებული უჯარმის ციხე-სიმაგრე?', a: 'უჯარმის ციხე-სიმაგრის პირველი ნაგებობები III–IV საუკუნეებს განეკუთვნება. ციხემ განსაკუთრებული სიდიადე V საუკუნეში მიაღწია, ვახტანგ გორგასლის მეფობის ხანაში, როდესაც ის სამეფო კარის ერთ-ერთ ოფიციალურ რეზიდენციად ჩამოყალიბდა.', key: 'faq2' },
          { q: 'შეიძლება თუ არა ციხის მონახულება?', a: 'დიახ, ციხე-სიმაგრის ტერიტორია ღიაა ვიზიტორებისათვის. ვინაიდან ეს კულტურული მემკვიდრეობის ობიექტია, გთხოვთ, დაიცვათ გარემო და გაიაროთ ნებისმიერი ორგანიზებული ექსკურსია ადგილობრივი გიდის ხელმძღვანელობით. დამატებითი ინფორმაციისთვის დაუკავშირდით სოფლის ადმინისტრაციას.', key: 'faq3' },
          { q: 'კახური ღვინოს სად შეიძლება დეგუსტაცია?', a: 'უჯარმის მიმდებარე ტერიტორიაზე რამდენიმე ოჯახური მარანია, სადაც ადგილობრივი ოჯახები ტრადიციული კახური ღვინის, მათ შორის ქვევრის ღვინის, დეგუსტაციას სთავაზობენ ვიზიტორებს. სოფლის ადმინისტრაციაში შეგიძლიათ მიიღოთ განახლებული სია ადგილობრივ ღვინის მწარმოებლებზე.', key: 'faq4' },
          { q: 'სოფელში სასტუმრო ან სახლ-სასტუმრო არსებობს?', a: 'სოფელი და მიმდებარე ტერიტორია სვამს ტურისტული ინფრასტრუქტურის გაუმჯობესებას. ამჟამად ყველაზე ხელმისაწვდომი ვარიანტია სახლ-სასტუმრო-ტიპის განთავსება ადგილობრივ ოჯახებთან ან ახლომდებარე საგარეჯოში. სოფლის ადმინისტრაცია განახლებულ ინფორმაციას წარმოადგენს ამ გვერდზე.', key: 'faq5' },
          { q: 'რა არის ვიზიტის საუკეთესო დრო?', a: 'კახეთი შესანიშნავია წლის სამ სეზონზე. გაზაფხული (მარტი–მაისი) — ბუნება ყვავის, ჰავა რბილია. ზაფხული (ივნისი–აგვისტო) — მზიანი, ცხელი, ვენახები ხილით. შემოდგომა (სექტემბერი–ოქტომბერი) — კახეთის ოქროს სეზონი, რთველი, ეროვნული ტრადიციები.', key: 'faq6' }
        ]; %>

        <% faqs.forEach(function(faq, idx) { %>
          <div class="about-faq-item" id="faq-<%= idx %>">
            <details>
              <summary class="about-faq-summary">
                <span class="about-faq-q" data-i18n="about.<%= faq.key %>Q"><%= faq.q %></span>
                <span class="about-faq-chevron" aria-hidden="true">
                  <i data-lucide="chevron-down"></i>
                </span>
              </summary>
              <div class="about-faq-answer" data-i18n="about.<%= faq.key %>A">
                <%= faq.a %>
              </div>
            </details>
          </div>
        <% }); %>

      </div>
    </div>
  </div>
</section>
