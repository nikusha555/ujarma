<!-- ═══ FAQ ═══ -->
<section class="section-alt section-sm">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10">

        <div class="section-label" style="justify-content:center;">ხშირად დასმული კითხვები</div>
        <h2 class="text-center" style="margin-bottom:2.5rem;">FAQ</h2>

        <!-- FAQ items using Bootstrap accordion look without JS dependency -->
        <% const faqs = [
          {
            q: 'სად მდებარეობს უჯარმა?',
            a: 'უჯარმა მდებარეობს საქართველოს კახეთის რეგიონში, საგარეჯოს მუნიციპალიტეტში, თბილისიდან დაახლოებით 60–65 კილომეტრის დაშორებით. ავტომობილით მგზავრობა დედაქალაქიდან ერთ საათამდე მიდის.'
          },
          {
            q: 'როდის იყო აშენებული უჯარმის ციხე-სიმაგრე?',
            a: 'უჯარმის ციხე-სიმაგრის პირველი ნაგებობები III–IV საუკუნეებს განეკუთვნება. ციხემ განსაკუთრებული სიდიადე V საუკუნეში მიაღწია, ვახტანგ გორგასლის მეფობის ხანაში, როდესაც ის სამეფო კარის ერთ-ერთ ოფიციალურ რეზიდენციად ჩამოყალიბდა.'
          },
          {
            q: 'შეიძლება თუ არა ციხის მონახულება?',
            a: 'დიახ, ციხე-სიმაგრის ტერიტორია ღიაა ვიზიტორებისათვის. ვინაიდან ეს კულტურული მემკვიდრეობის ობიექტია, გთხოვთ, დაიცვათ გარემო და გაიაროთ ნებისმიერი ორგანიზებული ექსკურსია ადგილობრივი გიდის ხელმძღვანელობით. დამატებითი ინფორმაციისთვის დაუკავშირდით სოფლის ადმინისტრაციას.'
          },
          {
            q: 'კახური ღვინოს სად შეიძლება დეგუსტაცია?',
            a: 'უჯარმის მიმდებარე ტერიტორიაზე რამდენიმე ოჯახური მარანია, სადაც ადგილობრივი ოჯახები ტრადიციული კახური ღვინის, მათ შორის ქვევრის ღვინის, დეგუსტაციას სთავაზობენ ვიზიტორებს. სოფლის ადმინისტრაციაში შეგიძლიათ მიიღოთ განახლებული სია ადგილობრივ ღვინის მწარმოებლებზე.'
          },
          {
            q: 'სოფელში სასტუმრო ან სახლ-სასტუმრო არსებობს?',
            a: 'სოფელი და მიმდებარე ტერიტორია სვამს ტურისტული ინფრასტრუქტურის გაუმჯობესებას. ამჟამად ყველაზე ხელმისაწვდომი ვარიანტია სახლ-სასტუმრო-ტიპის განთავსება ადგილობრივ ოჯახებთან ან ახლომდებარე საგარეჯოში. სოფლის ადმინისტრაცია განახლებულ ინფორმაციას წარმოადგენს ამ გვერდზე.'
          },
          {
            q: 'რა არის ვიზიტის საუკეთესო დრო?',
            a: 'კახეთი შესანიშნავია წლის სამ სეზონზე. გაზაფხული (მარტი–მაისი) — ბუნება ყვავის, ჰავა რბილია. ზაფხული (ივნისი–აგვისტო) — მზიანი, ცხელი, ვენახები ხილით. შემოდგომა (სექტემბერი–ოქტომბერი) — კახეთის ოქროს სეზონი, რთველი, ეროვნული ტრადიციები. ზამთარი უფრო조용 ხასიათისა, მაგრამ ახალი წლის ღვინოების სეზონი სოფელს განსაკუთრებულ სიმყუდროვეს ანიჭებს.'
          }
        ]; %>

        <% faqs.forEach(function(faq, idx) { %>
          <div style="border:1px solid var(--color-border);border-radius:var(--radius-md);margin-bottom:.875rem;overflow:hidden;">
            <details>
              <summary style="padding:1.125rem 1.375rem;cursor:pointer;font-weight:600;font-size:.9375rem;color:var(--color-primary);list-style:none;display:flex;justify-content:space-between;align-items:center;user-select:none;background:var(--white);">
                <span><%= faq.q %></span>
                <i data-lucide="chevron-down" style="width:.9rem;height:.9rem;flex-shrink:0;transition:transform .2s;"></i>
              </summary>
              <div style="padding:0 1.375rem 1.125rem;font-size:.9375rem;color:var(--color-text-secondary);line-height:1.75;background:var(--gray-50);border-top:1px solid var(--color-border);">
                <%= faq.a %>
              </div>
            </details>
          </div>
        <% }); %>

      </div>
    </div>
  </div>
</section>


<!-- Introduction -->
<section class="section section-sm">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10">

        <div class="section-label">The Village</div>
        <h2 style="margin-bottom:1.5rem;">A Settlement of Ancient Heritage</h2>

        <p class="lead" style="margin-bottom:1.75rem;">
          Ujarma is a historic village situated in the Sagarejo Municipality of the Kakheti
          region in eastern Georgia. It is best known for the Ujarma Fortress, one of the
          significant early medieval fortifications of the South Caucasus.
        </p>

        <p>
          The fortress of Ujarma dates back to the early centuries of the Common Era and
          served as a royal residence during the reign of several Georgian monarchs. The
          surrounding village has preserved its agrarian character through the centuries,
          remaining closely tied to the land and the winemaking traditions for which
          Kakheti is celebrated worldwide.
        </p>

        <p>
          Today, Ujarma is a quiet community that balances its deep historical roots with the
          needs of modern governance and rural development. The village administration is
          committed to maintaining transparency, providing quality public services, and
          preserving the natural and cultural heritage of the area for future generations.
        </p>

        <div class="separator" style="justify-content:flex-start;margin:2.5rem 0;">
          <span class="separator-line"></span>
          <span class="separator-diamond"></span>
        </div>

      </div>
    </div>
  </div>
</section>


