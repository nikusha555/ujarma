<%# pages/about.ejs — უჯარმის შესახებ | Premium redesign -%>

<!-- ═══════════════════════════════════════════════════════
     HERO — full-height immersive banner
════════════════════════════════════════════════════════ -->
<section class="about-hero" aria-label="გვერდის სათაური">
  <!-- SVG dot-grid texture (same as site hero) -->
  <div class="about-hero-texture" aria-hidden="true"></div>

  <div class="about-hero-content">
    <div class="container">
      <!-- Breadcrumb -->
      <nav aria-label="ნავიგაცია" class="about-hero-breadcrumb">
