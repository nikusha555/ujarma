<%# pages/about.ejs — უჯარმის შესახებ | Premium redesign -%>

<!-- ═══════════════════════════════════════════════════════
     HERO — full-height immersive banner
════════════════════════════════════════════════════════ -->
<section class="about-hero" aria-label="გვერდის ბანერი" data-i18n-aria-label="common.pageBannerLabel">
  <!-- SVG dot-grid texture (same as site hero) -->
  <div class="about-hero-texture" aria-hidden="true"></div>

  <div class="about-hero-content">
    <div class="container">
      <!-- Breadcrumb -->
      <nav aria-label="ნავიგაცია" class="about-hero-breadcrumb" data-i18n-aria-label="common.breadcrumbLabel">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="/" data-i18n="breadcrumb.home">მთავარი</a></li>
          <li class="breadcrumb-item active" aria-current="page" style="color:rgba(255,255,255,.55);" data-i18n="breadcrumb.about">უჯარმის შესახებ</li>
        </ol>
      </nav>

      <!-- Emblem — official Ujarma logo mark -->
      <div class="about-hero-emblem" aria-hidden="true">
        <img src="/images/ujarma-logo-mark.png?v=<%= assetVersion %>" alt="" class="site-logo-img" width="488" height="561" />
      </div>

      <div class="section-label about-hero-label" data-i18n="about.heroLabel">კახეთი · საქართველო</div>
      <h1 class="about-hero-title">უჯარმა</h1>
      <p class="about-hero-subtitle" data-i18n="about.heroSubtitle">ისტორია, კულტურა, ბუნება და თანამედროვე ცხოვრება</p>

      <!-- Separator -->
      <div class="hero-separator" aria-hidden="true" style="justify-content:center;margin:1.5rem 0 0;">
        <span class="hero-sep-line"></span>
        <span class="hero-sep-diamond"></span>
        <span class="hero-sep-line"></span>
      </div>
    </div>
  </div>

  <div class="hero-gold-line" aria-hidden="true"></div>
</section>


<!-- ═══════════════════════════════════════════════════════
     INTRO — wide two-paragraph lead
════════════════════════════════════════════════════════ -->
<section class="about-intro">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <div class="section-label" data-i18n="about.villageLabel">სოფელი</div>
        <h2 class="about-section-heading" data-i18n="about.introHeading">ძველი სამეფოს გული — უჯარმა</h2>

        <p class="about-lead-text" data-i18n="about.introPara1">
          უჯარმა საქართველოს ერთ-ერთი ყველაზე სახელოვანი ისტორიული სოფელია,
          რომელიც საგარეჯოს მუნიციპალიტეტში, კახეთის რეგიონში მდებარეობს.
          სოფელი განთქმულია უჯარმის ციხე-სიმაგრით — ადრეული შუა საუკუნეების
          ერთ-ერთი ყველაზე მნიშვნელოვანი სამეფო რეზიდენციით სამხრეთ კავკასიაში.
        </p>

        <p class="about-body-text" data-i18n="about.introPara2">
          ადრეული ქრისტიანული საქართველოს ეპოქიდან მოყოლებული, უჯარმამ
          განსაკუთრებული ადგილი დაიკავა ქართული სახელმწიფოებრიობის ისტორიაში.
          V საუკუნეში, ვახტანგ გორგასლის მეფობის დროს, უჯარმა მეფის ერთ-ერთ
          საყვარელ რეზიდენციად იქცა.
        </p>

        <p class="about-body-text" data-i18n="about.introPara3">
          საუკუნეთა განმავლობაში უჯარმამ შეინარჩუნა სასოფლო-სამეურნეო
          ხასიათი, მჭიდრო კავშირი მიწასა და ვაზის კულტურასთან. დღეს სოფელი
          ისეთი ადგილია, სადაც ისტორია ცოცხლობს ყოველ ქვასა და ლანდშაფტში.
        </p>
      </div>

      <!-- Right: stat cards vertical stack -->
      <div class="col-lg-6">
        <div class="row g-3">
          <div class="col-6">
            <div class="about-stat-card">
              <i data-lucide="map-pin" class="about-stat-icon"></i>
              <div class="about-stat-label" data-i18n="about.statLocationLabel">მდებარეობა</div>
              <div class="about-stat-value" data-i18n="about.statLocationValue">საგარეჯო, კახეთი</div>
              <div class="about-stat-sub" data-i18n="about.statLocationSub">60 კმ თბილისიდან</div>
            </div>
          </div>
          <div class="col-6">
            <div class="about-stat-card">
              <i data-lucide="landmark" class="about-stat-icon"></i>
              <div class="about-stat-label" data-i18n="about.statMonumentLabel">ძეგლი</div>
              <div class="about-stat-value" data-i18n="about.statMonumentValue">III–VII სს.</div>
              <div class="about-stat-sub" data-i18n="about.statMonumentSub">ეროვნული მემკვიდრეობა</div>
            </div>
          </div>
          <div class="col-6">
            <div class="about-stat-card about-stat-card--accent">
              <i data-lucide="crown" class="about-stat-icon"></i>
              <div class="about-stat-label" data-i18n="about.statRoyalResLabel">სამეფო რეზიდენცია</div>
              <div class="about-stat-value" data-i18n="about.statRoyalResValue">ვახტანგ გორგასალი</div>
              <div class="about-stat-sub" data-i18n="about.statRoyalResSub">V საუკუნე</div>
            </div>
          </div>
          <div class="col-6">
            <div class="about-stat-card">
              <i data-lucide="grape" class="about-stat-icon"></i>
              <div class="about-stat-label" data-i18n="about.statRegionLabel">რეგიონი</div>
              <div class="about-stat-value" data-i18n="about.statRegionValue">კახეთი</div>
              <div class="about-stat-sub" data-i18n="about.statRegionSub">ღვინის სამშობლო</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     HISTORY — two-column with decorative timeline
════════════════════════════════════════════════════════ -->
<section class="about-alt-section">
  <div class="container">
    <div class="row align-items-start g-5">

      <!-- Visual: timeline column -->
      <div class="col-lg-4 d-none d-lg-block">
        <div class="about-timeline">
          <div class="about-timeline-item">
            <div class="about-timeline-dot"></div>
          <div class="about-timeline-year" data-i18n="about.timelineItem1Year">III–IV სს.</div>
            <div class="about-timeline-desc" data-i18n="about.timelineItem1Desc">პირველი ნახსენები „ქართლის ცხოვრებიში“</div>
          </div>
          <div class="about-timeline-item">
            <div class="about-timeline-dot about-timeline-dot--gold"></div>
            <div class="about-timeline-year" data-i18n="about.timelineItem2Year">V საუკუნე</div>
            <div class="about-timeline-desc" data-i18n="about.timelineItem2Desc">ვახტანგ გორგასლის სამეფო რეზიდენცია</div>
          </div>
          <div class="about-timeline-item">
            <div class="about-timeline-dot"></div>
            <div class="about-timeline-year" data-i18n="about.timelineItem3Year">VI–VII სს.</div>
            <div class="about-timeline-desc" data-i18n="about.timelineItem3Desc">სტრატეგიული სამხედრო ობიექტი</div>
          </div>
          <div class="about-timeline-item">
            <div class="about-timeline-dot"></div>
            <div class="about-timeline-year" data-i18n="about.timelineItem4Year">დღეს</div>
            <div class="about-timeline-desc" data-i18n="about.timelineItem4Desc">ეროვნული კულტურული მემკვიდრეობა</div>
          </div>
        </div>
      </div>

      <!-- Text column -->
      <div class="col-lg-8">
        <div class="section-label" data-i18n="about.historyLabel">ისტორია</div>
        <h2 class="about-section-heading" data-i18n="about.historyHeading">მრავალსაუკუნოვანი ისტორია</h2>

        <p class="about-body-text" data-i18n="about.historyPara1">
          უჯარმის პირველი ნახსენებები ძველ ქართულ წყაროებში III–IV საუკუნეებს
          განეკუთვნება. ძველი სახელი „უჯარმა" ვახუშტი ბაგრატიონის ნაშრომებსა
          და „ქართლის ცხოვრებაში" მოხსენიებულია, როგორც კახეთის ერთ-ერთი
          ყველაზე გამაგრებული ციხე-სიმაგრე.
        </p>

        <!-- Highlighted quote -->
        <blockquote class="about-blockquote" data-i18n="about.historyQuote">
          V საუკუნეში, ვახტანგ გორგასლის მეფობის პერიოდში, უჯარმა
          სამეფო კარის ფავორიტ ადგილად გადაიქცა. მეფე-მეომარი ხშირად
          ამ ციხე-სიმაგრეში ბნავდა კახეთის კამპანიების განმავლობაში.
        </blockquote>

        <p class="about-body-text" data-i18n="about.historyPara2">
          VI–VII საუკუნეებში, ქართლ-კახეთის სამეფოს განვითარების ეტაპზე,
          უჯარმამ საბოლოოდ განიმტკიცა მდგომარეობა როგორც სტრატეგიულ-სამხედრო
          ობიექტმა — კახეთის სამხრეთ ჭიშკართან. ციხის ქვეშ გამავალი გზა
          ვაჭრობისა და სამხედრო მოძრაობისათვის პრიორიტეტულ მარშრუტს
          წარმოადგენდა.
        </p>

        <p class="about-body-text" data-i18n="about.historyPara3">
          შუა საუკუნეებში, ქვეყანაში სხვადასხვა დაპყრობების ფონზე,
          უჯარმამ ნაწილობრივ დაკარგა ყოფილი ბრწყინვალება, თუმცა
          სოფელი გადარჩა. დღეს ციხის ნანგრევები ეროვნული კულტურული
          მემკვიდრეობის ნიმუშად სახელმწიფო დაცვის ქვეშ არის.
        </p>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     GEOGRAPHY — icon highlights
════════════════════════════════════════════════════════ -->
<section class="about-white-section">
  <div class="container">
    <div class="row align-items-center g-5">

      <div class="col-lg-5">
        <div class="section-label" data-i18n="about.geographyLabel">გეოგრაფია</div>
        <h2 class="about-section-heading" data-i18n="about.geographyHeading">ბუნება და განლაგება</h2>

        <p class="about-body-text" data-i18n="about.geoPara1">
          უჯარმა გეოგრაფიულად კახეთის ვაკე-მთიანი ზოლის
          ჩრდილო-დასავლეთ კიდეზე მდებარეობს, საგარეჯოს
          მუნიციპალიტეტში. სოფლის ახლოს გაედინება იორი —
          ქართლ-კახეთის ერთ-ერთი მთავარი მდინარე.
        </p>

        <p class="about-body-text" data-i18n="about.geoPara2">
          ადგილი ზღვის დონიდან 400–600 მეტრის სიმაღლეზეა.
          სოფლიდან 60–65 კმ-ია თბილისამდე, ხოლო
          საგარეჯო — 25 კმ-ის მოშორებით.
        </p>
      </div>

      <div class="col-lg-7">
        <div class="row g-3">
          <div class="col-sm-6">
            <div class="about-geo-card">
              <i data-lucide="waves" class="about-geo-icon"></i>
              <div class="about-geo-title" data-i18n="about.geoCard1Title">იორის ხეობა</div>
              <div class="about-geo-text" data-i18n="about.geoCard1Text">კახეთის ერთ-ერთი ყველაზე ლამაზი ბუნებრივი ლანდშაფტი, გასაოცარი პანორამული ხედებით</div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="about-geo-card">
              <i data-lucide="mountain" class="about-geo-icon"></i>
              <div class="about-geo-title" data-i18n="about.geoCard2Title">სიმაღლე 400–600 მ</div>
              <div class="about-geo-text" data-i18n="about.geoCard2Text">ზღვის დონიდან — ვაზის მოყვანის საუკეთესო ბუნებრივი პირობები</div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="about-geo-card">
              <i data-lucide="sun" class="about-geo-icon"></i>
              <div class="about-geo-title" data-i18n="about.geoCard3Title">კახური კლიმატი</div>
              <div class="about-geo-text" data-i18n="about.geoCard3Text">ნახევრად-მშრალი: ცხელი ზაფხული, რბილი ზამთარი, ოქროვანი შემოდგომა</div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="about-geo-card">
              <i data-lucide="route" class="about-geo-icon"></i>
              <div class="about-geo-title" data-i18n="about.geoCard4Title">60 კმ თბილისიდან</div>
              <div class="about-geo-text" data-i18n="about.geoCard4Text">ავტომობილით 1 საათის სავალი — იდეალური ერთდღიანი ექსკურსია</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     CULTURE — card layout
════════════════════════════════════════════════════════ -->
<section class="about-alt-section">
  <div class="container">
    <div class="row justify-content-center mb-5">
      <div class="col-lg-7 text-center">
        <div class="section-label" style="justify-content:center;" data-i18n="about.cultureLabel">კულტურა</div>
        <h2 class="about-section-heading mb-2" data-i18n="about.cultureHeading">ტრადიციები და ცხოვრების წესი</h2>
        <p class="about-body-text" style="color:var(--color-text-secondary);" data-i18n="about.culturePara">
          კახეთი არის არა მხოლოდ საქართველოს ღვინის სამშობლო, არამედ
          ქართული ტრადიციული კულტურის ერთ-ერთი მდიდარი კერა.
        </p>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-4 col-md-6">
        <div class="about-culture-card">
          <div class="about-culture-icon-wrap">
            <i data-lucide="wine" class="about-culture-icon"></i>
          </div>
          <h3 class="about-culture-title" data-i18n="about.cultureCard1Title">ქვევრის ღვინო</h3>
          <p class="about-culture-text" data-i18n="about.cultureCard1Text">
            უჯარმისა და მიმდებარე სოფლების მოსახლეობა ინარჩუნებს
            მრავალსაუკუნოვან ყოფა-ცხოვრების წესს: ქვევრის ღვინოს
            დაყენებას — ტრადიციას, რომელიც UNESCO-ს არამატერიალური
            მემკვიდრეობის სიაშია.
          </p>
        </div>
      </div>
      <div class="col-lg-4 col-md-6">
        <div class="about-culture-card about-culture-card--featured">
          <div class="about-culture-icon-wrap about-culture-icon-wrap--gold">
            <i data-lucide="wheat" class="about-culture-icon about-culture-icon--white"></i>
          </div>
          <h3 class="about-culture-title" data-i18n="about.cultureCard2Title">რთველი</h3>
          <p class="about-culture-text" data-i18n="about.cultureCard2Text">
            სოფლის კალენდარი ვაზის ციკლს მიჰყვება. ზაფხულის
            ბოლოს რთველი — ყველაზე მხიარული და ოჯახური
            დღესასწაული — ახლაც ისევე ხალისიანად იმართება,
            როგორც ათი თაობის წინ.
          </p>
        </div>
      </div>
      <div class="col-lg-4 col-md-6">
        <div class="about-culture-card">
          <div class="about-culture-icon-wrap">
            <i data-lucide="church" class="about-culture-icon"></i>
          </div>
          <h3 class="about-culture-title" data-i18n="about.cultureCard3Title">კომუნიტარული სიახლოვე</h3>
          <p class="about-culture-text" data-i18n="about.cultureCard3Text">
            უჯარმის სკოლა, კულტურის სახლი და ადგილობრივი ეკლესია
            სოფლის სოციალური ცხოვრების ღერძია. ყოველწლიური
            ამბობ-ლოცვები და ისტორიული დღესასწაულები ქმნის
            სოფლის ყველაზე ძვირფას სიმდიდრეს.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
