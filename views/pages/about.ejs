<!-- Administration -->
<section class="section section-sm">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10">

        <div class="section-label">ადმინისტრაცია</div>
        <h2 style="margin-bottom:1.5rem;">სოფლის მმართველობა</h2>

        <p>
          უჯარმის სოფლის ადმინისტრაცია პასუხისმებაა ლოკალური წვევესაური საკითხეების,
          ინფრასტრუქტურის მოვლა-პატრონიბის, გახლებული სერვისებისა და
          ტერიტორიის ბუნებრივი და კულტურული მემკვიდრეობის დაცვას გენერაციისთვის.
        </p>

        <p>
          ადმინისტრაცია მოქმეၖ4ებს საქართველოს კანონმდებლობის შესაბამისად და გამტისტად გამტანგარებელობით
          უზრუნველს ყველა მოსახლეს უფლებათ სარგებლად ნაბავის საძლებლობასა.
        </p>

