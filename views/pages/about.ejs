          <li class="breadcrumb-item"><a href="/">მთავარი</a></li>
          <li class="breadcrumb-item active" aria-current="page" style="color:rgba(255,255,255,.55);">უჯარმის შესახებ</li>
        </ol>
      </nav>

      <!-- Emblem -->
      <div class="about-hero-emblem" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 72" width="56" height="66">
          <path d="M30 3 L57 15 L57 44 Q57 64 30 70 Q3 64 3 44 L3 15 Z" fill="none" stroke="rgba(197,160,40,.7)" stroke-width="1.5"/>
          <path d="M30 8 L52 19 L52 43 Q52 60 30 66 Q8 60 8 43 L8 19 Z" fill="rgba(10,22,40,.35)"/>
          <line x1="30" y1="18" x2="30" y2="56" stroke="rgba(197,160,40,.7)" stroke-width="1.75"/>
          <line x1="11" y1="37" x2="49" y2="37" stroke="rgba(197,160,40,.7)" stroke-width="1.75"/>
          <circle cx="30" cy="37" r="4" fill="none" stroke="rgba(197,160,40,.7)" stroke-width="1.25"/>
          <circle cx="30" cy="37" r="1.5" fill="rgba(197,160,40,.9)"/>
        </svg>
      </div>

      <div class="section-label about-hero-label">კახეთი · საქართველო</div>
      <h1 class="about-hero-title">უჯარმა</h1>
      <p class="about-hero-subtitle">ისტორია, კულტურა, ბუნება და თანამედროვე ცხოვრება</p>

      <!-- Separator -->
      <div class="hero-separator" aria-hidden="true" style="justify-content:center;margin:1.5rem 0 0;">
        <span class="hero-sep-line"></span>
        <span class="hero-sep-diamond"></span>
        <span class="hero-sep-line"></span>
      </div>
    </div>
  </div>

  <div class="hero-gold-line" aria-hidden="true"></div>
</section>


<!-- ═══════════════════════════════════════════════════════
     INTRO — wide two-paragraph lead
════════════════════════════════════════════════════════ -->
<section class="about-intro">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <div class="section-label">სოფელი</div>
        <h2 class="about-section-heading">ძველი სამეფოს გული — უჯარმა</h2>

        <p class="about-lead-text">
          უჯარმა საქართველოს ერთ-ერთი ყველაზე სახელოვანი ისტორიული სოფელია,
          რომელიც საგარეჯოს მუნიციპალიტეტში, კახეთის რეგიონში მდებარეობს.
          სოფელი განთქმულია უჯარმის ციხე-სიმაგრით — ადრეული შუა საუკუნეების
          ერთ-ერთი ყველაზე მნიშვნელოვანი სამეფო რეზიდენციით სამხრეთ კავკასიაში.
        </p>

        <p class="about-body-text">
          ადრეული ქრისტიანული საქართველოს ეპოქიდან მოყოლებული, უჯარმამ
          განსაკუთრებული ადგილი დაიკავა ქართული სახელმწიფოებრიობის ისტორიაში.
          V საუკუნეში, ვახტანგ გორგასლის მეფობის დროს, უჯარმა მეფის ერთ-ერთ
          საყვარელ რეზიდენციად იქცა.
        </p>

        <p class="about-body-text">
          საუკუნეთა განმავლობაში უჯარმამ შეინარჩუნა სასოფლო-სამეურნეო
          ხასიათი, მჭიდრო კავშირი მიწასა და ვაზის კულტურასთან. დღეს სოფელი
          ისეთი ადგილია, სადაც ისტორია ცოცხლობს ყოველ ქვასა და ლანდშაფტში.
        </p>
      </div>

      <!-- Right: stat cards vertical stack -->
      <div class="col-lg-6">
        <div class="row g-3">
          <div class="col-6">
            <div class="about-stat-card">
              <i data-lucide="map-pin" class="about-stat-icon"></i>
              <div class="about-stat-label">მდებარეობა</div>
              <div class="about-stat-value">საგარეჯო, კახეთი</div>
              <div class="about-stat-sub">60 კმ თბილისიდან</div>
            </div>
          </div>
          <div class="col-6">
            <div class="about-stat-card">
              <i data-lucide="landmark" class="about-stat-icon"></i>
              <div class="about-stat-label">ძეგლი</div>
              <div class="about-stat-value">III–VII სს.</div>
              <div class="about-stat-sub">ეროვნული მემკვიდრეობა</div>
            </div>
          </div>
          <div class="col-6">
            <div class="about-stat-card about-stat-card--accent">
              <i data-lucide="crown" class="about-stat-icon"></i>
              <div class="about-stat-label">სამეფო რეზიდენცია</div>
              <div class="about-stat-value">ვახტანგ გორგასალი</div>
              <div class="about-stat-sub">V საუკუნე</div>
            </div>
          </div>
          <div class="col-6">
            <div class="about-stat-card">
              <i data-lucide="grape" class="about-stat-icon"></i>
              <div class="about-stat-label">რეგიონი</div>
              <div class="about-stat-value">კახეთი</div>
              <div class="about-stat-sub">ღვინის სამშობლო</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     HISTORY — two-column with decorative timeline
════════════════════════════════════════════════════════ -->
<section class="about-alt-section">
  <div class="container">
    <div class="row align-items-start g-5">

      <!-- Visual: timeline column -->
      <div class="col-lg-4 d-none d-lg-block">
        <div class="about-timeline">
          <div class="about-timeline-item">
            <div class="about-timeline-dot"></div>
            <div class="about-timeline-year">III–IV სს.</div>
            <div class="about-timeline-desc">პირველი ნახსენები „ქართლის ცხოვრებაში"</div>
          </div>
          <div class="about-timeline-item">
            <div class="about-timeline-dot about-timeline-dot--gold"></div>
            <div class="about-timeline-year">V საუკუნე</div>
            <div class="about-timeline-desc">ვახტანგ გორგასლის სამეფო რეზიდენცია</div>
          </div>
          <div class="about-timeline-item">
            <div class="about-timeline-dot"></div>
            <div class="about-timeline-year">VI–VII სს.</div>
            <div class="about-timeline-desc">სტრატეგიული სამხედრო ობიექტი</div>
          </div>
          <div class="about-timeline-item">
            <div class="about-timeline-dot"></div>
            <div class="about-timeline-year">დღეს</div>
            <div class="about-timeline-desc">ეროვნული კულტურული მემკვიდრეობა</div>
          </div>
        </div>
      </div>

      <!-- Text column -->
      <div class="col-lg-8">
        <div class="section-label">ისტორია</div>
        <h2 class="about-section-heading">მრავალსაუკუნოვანი ისტორია</h2>

        <p class="about-body-text">
          უჯარმის პირველი ნახსენებები ძველ ქართულ წყაროებში III–IV საუკუნეებს
          განეკუთვნება. ძველი სახელი „უჯარმა" ვახუშტი ბაგრატიონის ნაშრომებსა
          და „ქართლის ცხოვრებაში" მოხსენიებულია, როგორც კახეთის ერთ-ერთი
          ყველაზე გამაგრებული ციხე-სიმაგრე.
        </p>

        <!-- Highlighted quote -->
        <blockquote class="about-blockquote">
          V საუკუნეში, ვახტანგ გორგასლის მეფობის პერიოდში, უჯარმა
          სამეფო კარის ფავორიტ ადგილად გადაიქცა. მეფე-მეომარი ხშირად
          ამ ციხე-სიმაგრეში ბნავდა კახეთის კამპანიების განმავლობაში.
        </blockquote>

        <p class="about-body-text">
          VI–VII საუკუნეებში, ქართლ-კახეთის სამეფოს განვითარების ეტაპზე,
          უჯარმამ საბოლოოდ განიმტკიცა მდგომარეობა როგორც სტრატეგიულ-სამხედრო
          ობიექტმა — კახეთის სამხრეთ ჭიშკართან. ციხის ქვეშ გამავალი გზა
          ვაჭრობისა და სამხედრო მოძრაობისათვის პრიორიტეტულ მარშრუტს
          წარმოადგენდა.
        </p>

        <p class="about-body-text">
          შუა საუკუნეებში, ქვეყანაში სხვადასხვა დაპყრობების ფონზე,
          უჯარმამ ნაწილობრივ დაკარგა ყოფილი ბრწყინვალება, თუმცა
          სოფელი გადარჩა. დღეს ციხის ნანგრევები ეროვნული კულტურული
          მემკვიდრეობის ნიმუშად სახელმწიფო დაცვის ქვეშ არის.
        </p>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     GEOGRAPHY — icon highlights
════════════════════════════════════════════════════════ -->
<section class="about-white-section">
  <div class="container">
    <div class="row align-items-center g-5">

      <div class="col-lg-5">
        <div class="section-label">გეოგრაფია</div>
        <h2 class="about-section-heading">ბუნება და განლაგება</h2>

        <p class="about-body-text">
          უჯარმა გეოგრაფიულად კახეთის ვაკე-მთიანი ზოლის
          ჩრდილო-დასავლეთ კიდეზე მდებარეობს, საგარეჯოს
          მუნიციპალიტეტში. სოფლის ახლოს გაედინება იორი —
          ქართლ-კახეთის ერთ-ერთი მთავარი მდინარე.
        </p>

        <p class="about-body-text">
          ადგილი ზღვის დონიდან 400–600 მეტრის სიმაღლეზეა.
          სოფლიდან 60–65 კმ-ია თბილისამდე, ხოლო
          საგარეჯო — 25 კმ-ის მოშორებით.
        </p>
      </div>

      <div class="col-lg-7">
        <div class="row g-3">
          <div class="col-sm-6">
            <div class="about-geo-card">
              <i data-lucide="waves" class="about-geo-icon"></i>
              <div class="about-geo-title">იორის ხეობა</div>
              <div class="about-geo-text">კახეთის ერთ-ერთი ყველაზე ლამაზი ბუნებრივი ლანდშაფტი, გასაოცარი პანორამული ხედებით</div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="about-geo-card">
              <i data-lucide="mountain" class="about-geo-icon"></i>
              <div class="about-geo-title">სიმაღლე 400–600 მ</div>
              <div class="about-geo-text">ზღვის დონიდან — ვაზის მოყვანის საუკეთესო ბუნებრივი პირობები</div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="about-geo-card">
              <i data-lucide="sun" class="about-geo-icon"></i>
              <div class="about-geo-title">კახური კლიმატი</div>
              <div class="about-geo-text">ნახევრად-მშრალი: ცხელი ზაფხული, რბილი ზამთარი, ოქრო შემოდგომა</div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="about-geo-card">
              <i data-lucide="route" class="about-geo-icon"></i>
              <div class="about-geo-title">60 კმ თბილისიდან</div>
              <div class="about-geo-text">ავტომობილით 1 საათის სავალი — იდეალური ერთდღიანი ექსკურსია</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     CULTURE — card layout
════════════════════════════════════════════════════════ -->
<section class="about-alt-section">
  <div class="container">
    <div class="row justify-content-center mb-5">
      <div class="col-lg-7 text-center">
        <div class="section-label" style="justify-content:center;">კულტურა</div>
        <h2 class="about-section-heading mb-2">ტრადიციები და ცხოვრების წესი</h2>
        <p class="about-body-text" style="color:var(--color-text-secondary);">
          კახეთი არის არა მხოლოდ საქართველოს ღვინის სამშობლო, არამედ
          ქართული ტრადიციული კულტურის ერთ-ერთი მდიდარი კერა.
        </p>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-4 col-md-6">
        <div class="about-culture-card">
          <div class="about-culture-icon-wrap">
            <i data-lucide="wine" class="about-culture-icon"></i>
          </div>
          <h3 class="about-culture-title">ქვევრის ღვინო</h3>
          <p class="about-culture-text">
            უჯარმისა და მიმდებარე სოფლების მოსახლეობა ინარჩუნებს
            მრავალსაუკუნოვან ყოფა-ცხოვრების წესს: ქვევრის ღვინოს
            დაყენებას — ტრადიციას, რომელიც UNESCO-ს არამატერიალური
            მემკვიდრეობის სიაშია.
          </p>
        </div>
      </div>
      <div class="col-lg-4 col-md-6">
        <div class="about-culture-card about-culture-card--featured">
          <div class="about-culture-icon-wrap about-culture-icon-wrap--gold">
            <i data-lucide="wheat" class="about-culture-icon about-culture-icon--white"></i>
          </div>
          <h3 class="about-culture-title">რთველი</h3>
          <p class="about-culture-text">
            სოფლის კალენდარი ვაზის ციკლს მიჰყვება. ზაფხულის
            ბოლოს რთველი — ყველაზე მხიარული და ოჯახური
            დღესასწაული — ახლაც ისევე ხალისიანად იმართება,
            როგორც ათი თაობის წინ.
          </p>
        </div>
      </div>
      <div class="col-lg-4 col-md-6">
        <div class="about-culture-card">
          <div class="about-culture-icon-wrap">
            <i data-lucide="church" class="about-culture-icon"></i>
          </div>
          <h3 class="about-culture-title">კომუნიტარული სიახლოვე</h3>
          <p class="about-culture-text">
            უჯარმის სკოლა, კულტურის სახლი და ადგილობრივი ეკლესია
            სოფლის სოციალური ცხოვრების ღერძია. ყოველწლიური
            ამბობ-ლოცვები და ისტორიული დღესასწაულები ქმნის
            სოფლის ყველაზე ძვირფას სიმდიდრეს.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     TOURISM — attractive highlight cards
════════════════════════════════════════════════════════ -->
<section class="about-white-section">
  <div class="container">

    <div class="row align-items-end mb-5 g-3">
      <div class="col-lg-7">
        <div class="section-label">ტურიზმი</div>
        <h2 class="about-section-heading mb-1">უჯარმა — ისტორიული ტურიზმის მიმართულება</h2>
        <p class="about-body-text" style="color:var(--color-text-secondary);margin-bottom:0;">
          კახეთის ტურისტული მარშრუტების ერთ-ერთ მნიშვნელოვან გაჩერებად ქცეული,
          უჯარმა ყოველწლიურად ათასობით ვიზიტორს იღებს.
        </p>
      </div>
      <div class="col-lg-5 text-lg-end">
        <a href="/attractions" class="btn-primary-custom">ყველა ღირსშესანიშნაობა</a>
      </div>
    </div>

    <!-- Tourism highlights grid -->
    <div class="row g-3">
      <% const tourItems = [
        { icon:'landmark',    title:'ციხე-სიმაგრე',       desc:'III–VII სს. ეროვნული ძეგლის მოპირდაპირე კლდოვანი ბორცვი' },
        { icon:'eye',         title:'პანორამული ხედები',  desc:'იორის ხეობის გასაოცარი ბუნებრივი სილამაზე' },
        { icon:'wine',        title:'ღვინის დეგუსტაცია',  desc:'ადგილობრივი ოჯახური მარნები, კახური ქვევრის ღვინო' },
        { icon:'utensils',    title:'ქართული სამზარეულო', desc:'ადგილობრივი ოჯახების ტრადიციული კახური სუფრა' },
        { icon:'footprints',  title:'ისტორიული ბილიკი',   desc:'ვახტანგ გორგასლის ბილიკი — 2-3 სთ. ტრეილი' },
        { icon:'camera',      title:'ფოტოგრაფია',         desc:'იდეალური ადგილი — განსაკუთრებით გამთენიისას' },
      ]; %>
      <% tourItems.forEach(function(item) { %>
        <div class="col-lg-4 col-md-6">
          <div class="about-tour-card">
            <div class="about-tour-icon-wrap">
              <i data-lucide="<%= item.icon %>"></i>
            </div>
            <div>
              <div class="about-tour-title"><%= item.title %></div>
              <div class="about-tour-desc"><%= item.desc %></div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Sub-text + CTA -->
    <div class="row justify-content-center mt-5">
      <div class="col-lg-8 text-center">
        <p class="about-body-text" style="color:var(--color-text-secondary);margin-bottom:1.5rem;">
          ტურისტული ინფრასტრუქტურის გაუმჯობესება სოფლის ადმინისტრაციის
          ერთ-ერთი მთავარი პრიორიტეტია. მუშავდება გეგმები სტუმართმოყვარეობის
          ობიექტების და ისტორიული მარშრუტების მოწყობის შესახებ.
        </p>
        <a href="/contact"
           style="font-size:.8125rem;font-weight:600;letter-spacing:.06em;color:var(--color-text-muted);display:inline-flex;align-items:center;gap:.5rem;">
          სამოგზაურო ინფორმაცია
          <i data-lucide="arrow-right" class="icon-inline"></i>
        </a>
      </div>
    </div>

  </div>
</section>


