<%# pages/attraction-detail.ejs — ღირსშესანიშნაობის დეტალური -%>

<section class="page-banner" aria-label="გვერდის ერთაური">
  <div class="container page-banner-content">
    <nav aria-label="ნავიგაცია">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">მთავარი</a></li>
        <li class="breadcrumb-item"><a href="/attractions">ღირსშესანიშნაობები</a></li>
        <li class="breadcrumb-item active" aria-current="page"><%= attraction.name %></li>
      </ol>
    </nav>
    <% if (attraction.category) { %>
      <div class="section-label" style="color:var(--gold-300);">
        <span style="width:16px;height:1px;background:var(--gold-300);display:inline-block;margin-right:.5rem;"></span>
        <%= attraction.category %>
      </div>
    <% } %>
    <h1 class="page-banner-title"><%= attraction.name %></h1>
  </div>
</section>

<!-- Attraction Content -->
<section class="section section-sm">
  <div class="container">
    <div class="row g-5 align-items-start">

      <!-- Main Content -->
      <div class="col-lg-8">
        <% if (attraction.image) { %>
          <img src="/uploads/<%= attraction.image %>"
               alt="<%= attraction.name %>"
               class="w-100 mb-4"
               style="border-radius:var(--radius-lg);object-fit:cover;max-height:520px;"
               loading="lazy" />
        <% } %>
        <div style="font-size:1.0625rem;line-height:1.75;color:var(--color-text);">
          <%= attraction.description %>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="col-lg-4">
        <div style="background:var(--gray-50);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:1.75rem;">
          <h3 style="font-family:var(--font-sans);font-size:.625rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:1.25rem;">
            Attraction Details
          </h3>
          <% if (attraction.category) { %>
            <div class="contact-info-item">
              <div class="contact-info-icon"><i data-lucide="tag"></i></div>
              <div>
                <div class="contact-info-label">კატეგორია</div>
                <p class="contact-info-value"><%= attraction.category %></p>
              </div>
            </div>
          <% } %>
          <div class="contact-info-item">
            <div class="contact-info-icon"><i data-lucide="map-pin"></i></div>
            <div>
              <div class="contact-info-label">მდებარეობა</div>
              <p class="contact-info-value">უჯარმა, კახეთის რეგიონი, საქართველო</p>
            </div>
          </div>
          <hr class="divider my-3">
          <a href="/contact" class="btn-primary-custom w-100 text-center d-block"
             style="padding:.65rem 1.25rem;font-size:.75rem;">
            ვიზიტის შესახებ კითხვა
          </a>
        </div>
      </div>

    </div>

    <div class="mt-5">
      <a href="/attractions" class="section-link">
        <i data-lucide="arrow-left" class="icon-inline"></i> ღირსშესანიშნაობებზე დაბრუნება
      </a>
    </div>

  </div>
</section>
