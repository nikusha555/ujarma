<%#  pages/home.ejs — Homepage -%>

<!-- ═══════════════════════════════════════════════════════
     HERO SECTION
════════════════════════════════════════════════════════ -->
<section class="hero" aria-label="მთავარი ბანერი" data-i18n-aria-label="common.heroLabel">
  <div class="hero-glow"></div>

  <div class="hero-content-wrap w-100">
    <div class="container">
      <div class="row justify-content-center text-center">
        <div class="col-xl-7 col-lg-8 col-md-10">

          <!-- Village Emblem -->
          <div class="hero-emblem" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 72" width="72" height="84">
              <path d="M30 3 L57 15 L57 44 Q57 64 30 70 Q3 64 3 44 L3 15 Z"
                    fill="none" stroke="#C5A028" stroke-width="1.5" opacity="0.85"/>
              <path d="M30 8 L52 19 L52 43 Q52 60 30 66 Q8 60 8 43 L8 19 Z"
                    fill="rgba(10,22,40,0.4)" stroke="none"/>
              <line x1="30" y1="18" x2="30" y2="56" stroke="#C5A028" stroke-width="1.75"/>
              <line x1="11" y1="37" x2="49" y2="37" stroke="#C5A028" stroke-width="1.75"/>
              <circle cx="30" cy="37" r="4.5" fill="none" stroke="#C5A028" stroke-width="1.25"/>
              <circle cx="30" cy="37" r="1.75" fill="#C5A028"/>
            </svg>
          </div>

          <!-- ადგილობრივი -->
          <p class="hero-location" data-i18n="hero.location">კახეთის რეგიონი &middot; საქართველო</p>

          <!-- სოფლის სახელი -->
          <h1 class="hero-title">უჯარმა</h1>

          <!-- სუბტიტრი -->
          <p class="hero-subtitle" data-i18n="hero.subtitle">უჯარმის ოფიციალური საინფორმაციო პორტალი</p>

          <!-- Gold Ornamental Separator -->
          <div class="hero-separator" aria-hidden="true">
            <span class="hero-sep-line"></span>
            <span class="hero-sep-diamond"></span>
            <span class="hero-sep-line"></span>
          </div>

          <!-- CTA ღილაკები -->
          <div class="hero-ctas">
            <a href="/about" class="btn-hero-primary" data-i18n="hero.ctaExplore">გაიცანით უჯარმა</a>
            <a href="/attractions" class="btn-hero-outline" data-i18n="nav.attractions">ღირსშესანიშნაობები</a>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- გადახვიაღების ინდიკატორი -->
  <div class="hero-scroll" id="heroScroll" role="button" tabindex="0"
       aria-label="შინაარსიან კონტენტზე"
       data-i18n-aria-label="hero.scrollAriaLabel">
    <span class="hero-scroll-label" data-i18n="hero.scrollLabel">გადაახვიეთ</span>
    <div class="hero-scroll-line"></div>
  </div>

  <!-- Bottom Gold Accent Line -->
  <div class="hero-gold-line" aria-hidden="true"></div>
</section>


<!-- ═══════════════════════════════════════════════════════
     HERITAGE STATISTICS STRIP
════════════════════════════════════════════════════════ -->
<section class="heritage-strip" aria-label="ისტორიული ფაქტები" data-i18n-aria-label="heritage.sectionLabel">
  <!-- dot-grid texture -->
  <div class="heritage-strip-texture" aria-hidden="true"></div>

  <div class="container heritage-strip-inner">
    <div class="row g-0">

      <!-- Card 1 -->
      <div class="col-lg-3 col-md-6">
        <div class="heritage-card">
          <div class="heritage-card-icon-wrap">
            <i data-lucide="landmark"></i>
          </div>
          <div class="heritage-card-figure" data-i18n="heritage.card1Figure">III–IV სს.</div>
          <div class="heritage-card-title" data-i18n="heritage.card1Title">უძველესი ისტორია</div>
          <div class="heritage-card-desc" data-i18n="heritage.card1Desc">
            ციხე-სიმაგრის პირველი ნახსენები „ქართლის ცხოვრებაში"
          </div>
          <div class="heritage-card-line" aria-hidden="true"></div>
        </div>
      </div>

      <!-- Card 2 (featured) -->
      <div class="col-lg-3 col-md-6">
        <div class="heritage-card heritage-card--gold">
          <div class="heritage-card-icon-wrap">
            <i data-lucide="crown"></i>
          </div>
          <div class="heritage-card-figure" data-i18n="heritage.card2Figure">ვახტანგ გორგასალი</div>
          <div class="heritage-card-title" data-i18n="heritage.card2Title">სამეფო რეზიდენცია</div>
          <div class="heritage-card-desc" data-i18n="heritage.card2Desc">
            V საუკუნის სამეფო კარის ფავორიტი და სტრატეგიული ობიექტი
          </div>
          <div class="heritage-card-line" aria-hidden="true"></div>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="col-lg-3 col-md-6">
        <div class="heritage-card">
          <div class="heritage-card-icon-wrap">
            <i data-lucide="map-pin"></i>
          </div>
          <div class="heritage-card-figure" data-i18n="heritage.card3Figure">კახეთი</div>
          <div class="heritage-card-title" data-i18n="heritage.card3Title">საგარეჯოს მუნიციპალიტეტი</div>
          <div class="heritage-card-desc" data-i18n="heritage.card3Desc">
            60 კმ თბილისიდან — ღვინის სამშობლოს გულში
          </div>
          <div class="heritage-card-line" aria-hidden="true"></div>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="col-lg-3 col-md-6">
        <div class="heritage-card">
          <div class="heritage-card-icon-wrap">
            <i data-lucide="shield-check"></i>
          </div>
          <div class="heritage-card-figure" data-i18n="heritage.card4Figure">ეროვნული მნიშვნელობა</div>
          <div class="heritage-card-title" data-i18n="heritage.card4Title">კულტურული მემკვიდრეობა</div>
          <div class="heritage-card-desc" data-i18n="heritage.card4Desc">
            სახელმწიფო დაცვის ქვეშ — ეროვნული ძეგლი
          </div>
          <div class="heritage-card-line" aria-hidden="true"></div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     LATEST NEWS SECTION
════════════════════════════════════════════════════════ -->
<section class="section" id="news" aria-labelledby="news-heading">
  <div class="container">

    <div class="section-heading d-flex justify-content-between align-items-end flex-wrap gap-3">
      <div>
        <div class="section-label" data-i18n="home.newsLabel">უახლესი სიახლეები</div>
        <h2 id="news-heading" class="mb-0" data-i18n="home.newsHeading">ბოლო განცხადებები</h2>
      </div>
      <a href="/news" class="section-link">
        <span data-i18n="home.viewAllNews">ყველა სიახლეები</span> <i data-lucide="arrow-right" class="icon-inline"></i>
      </a>
    </div>

    <% if (latestNews && latestNews.length > 0) { %>
      <div class="row g-4">
        <% latestNews.forEach(function(article) { %>
          <div class="col-lg-4 col-md-6">
            <article class="content-card h-100">
              <% const homeNewsImg = newsImageUrl(article.featured_image || article.image); %>
              <% if (homeNewsImg) { %>
                <img src="<%= homeNewsImg %>"
                     alt="<%= article.title %>"
                     class="content-card-img" loading="lazy" />
              <% } else { %>
                <div class="content-card-img-placeholder">
                  <i data-lucide="newspaper" style="width:2.5rem;height:2.5rem;color:var(--gray-300);"></i>
                </div>
              <% } %>
              <div class="content-card-body d-flex flex-column">
                <span class="news-date">
                  <i data-lucide="calendar" class="icon-inline"></i>
                  <span data-i18n-date="<%= new Date(article.published_at).toISOString() %>" data-i18n-date-style="long"><%= new Date(article.published_at).toLocaleDateString('ka-GE', { day:'numeric', month:'long', year:'numeric' }) %></span>
                </span>
                <h3 class="content-card-title mt-2">
                  <a href="/news/<%= article.slug %>"><%= article.title %></a>
                </h3>
                <% if (article.summary || article.excerpt) { %>
                  <p class="content-card-excerpt flex-grow-1"><%= article.summary || article.excerpt %></p>
                <% } %>
                <a href="/news/<%= article.slug %>" class="content-card-link mt-auto">
                  <span data-i18n="home.readMore">სრულად წაკითხნა</span> <i data-lucide="arrow-right" class="icon-inline"></i>
                </a>
              </div>
            </article>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon"><i data-lucide="newspaper"></i></div>
        <p data-i18n="home.noNews">სიახლეები და განცხადებები გამოჩნდება გამოქვეყნების შემდეგ.</p>
      </div>
    <% } %>

  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     ATTRACTIONS SECTION
════════════════════════════════════════════════════════ -->
<section class="section section-alt" aria-labelledby="attractions-heading">
  <div class="container">

    <div class="section-heading text-center section-heading-centered">
      <div class="section-label" data-i18n="home.attractionsLabel">გაიცანით უჯარმა</div>
      <h2 id="attractions-heading" data-i18n="home.attractionsHeading">გამორჩეული ღირსშესანიშნაობები</h2>
      <p class="lead mx-auto" style="max-width:540px;" data-i18n="home.attractionsDesc">
        აიკვლეთ ისტორიული ძეგლები, ისტორიული ადგილები და ფასეული სილამაზე, რომლებიც უჯარმას კულტურულ მარშრუტად ქმნის.
      </p>
    </div>

    <% if (featuredAttractions && featuredAttractions.length > 0) { %>
      <div class="row g-4">
        <% featuredAttractions.forEach(function(attr) { %>
          <div class="col-lg-4 col-md-6">
            <div class="attraction-card h-100">
              <div class="attraction-card-inner">
                <div class="attraction-icon">
                  <i data-lucide="landmark"></i>
                </div>
                <% if (attr.category) { %>
                  <span class="attraction-card-tag"><%= attr.category %></span>
                <% } %>
                <h3 class="attraction-card-title mt-2">
                  <a href="/attractions/<%= attr.slug %>" style="color:inherit;"><%= attr.name %></a>
                </h3>
                <p class="attraction-card-desc"><%= attr.description %></p>
                <a href="/attractions/<%= attr.slug %>" class="content-card-link d-inline-flex mt-3">
                  <span data-i18n="home.details">დეტალები</span> <i data-lucide="arrow-right" class="icon-inline"></i>
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon"><i data-lucide="map-pin"></i></div>
        <p data-i18n="home.noAttractions">გამორჩეული ღირსშესანიშნაობები დაემატება დამატების შემდეგ.</p>
      </div>
    <% } %>

    <div class="text-center mt-5">
      <a href="/attractions" class="btn-primary-custom" data-i18n="home.viewAllAttractions">ყველა ღირსშესანიშნაობება</a>
    </div>

  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     GALLERY PREVIEW SECTION
════════════════════════════════════════════════════════ -->
<section class="section" aria-labelledby="gallery-heading">
  <div class="container">

    <div class="section-heading d-flex justify-content-between align-items-end flex-wrap gap-3">
      <div>
        <div class="section-label" data-i18n="home.galleryLabel">გალერეა</div>
        <h2 id="gallery-heading" class="mb-0" data-i18n="home.galleryHeading">უჯარმადან</h2>
      </div>
      <a href="/gallery" class="section-link">
        <span data-i18n="home.viewAllGallery">სრული გალერეა</span> <i data-lucide="arrow-right" class="icon-inline"></i>
      </a>
    </div>

    <% if (recentGallery && recentGallery.length > 0) { %>
      <div class="gallery-grid">
        <% recentGallery.forEach(function(item) { %>
          <div class="gallery-item"
               data-src="/uploads/gallery/<%= item.image %>"
               title="<%= item.title %>">
            <img src="/uploads/gallery/<%= item.image %>"
                 alt="<%= item.title %>"
                 loading="lazy" />
            <div class="gallery-item-overlay">
              <i data-lucide="zoom-in"></i>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <!-- Placeholder grid shown when no images are uploaded yet -->
      <div class="gallery-grid">
        <% for (let i = 0; i < 8; i++) { %>
          <div class="gallery-item">
            <div class="gallery-placeholder">
              <i data-lucide="image"></i>
            </div>
          </div>
        <% } %>
      </div>
      <p class="text-center mt-3" style="font-size:.875rem;color:var(--color-text-muted);" data-i18n="home.noGalleryImages">
        გალერეის სურათები გამოჩნდება ატვირთვის შემდეგ.
      </p>
    <% } %>

  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     ABOUT PREVIEW SECTION
════════════════════════════════════════════════════════ -->
<section class="section section-alt" aria-labelledby="about-heading">
  <div class="container">
    <div class="row align-items-center g-5">

      <div class="col-lg-6 about-text-col">
        <div class="section-label" data-i18n="home.aboutLabel">უჯარმის შესახებ</div>
        <h2 id="about-heading" data-i18n="home.aboutHeading">ისტორიაში ფესვგადგმული სოფელი</h2>
        <p class="lead" data-i18n="home.aboutText1">
          უჯარმა არის ისტორიული დასახლება კახეთის რეგიონში, გამორჩეული ისტორიული ციხე-სიმაგრით და საქართველოს ადრეული სახელმწიფოებრიობის ისტორით.
        </p>
        <p data-i18n="home.aboutText2">
          კახეთის ბორცებსა და ვენახებში გარშემორტყული, უჯარმა საუკუნეების ისტორიას ინახავს კედლებსა და ლანდშაფტში.
        </p>
        <div class="separator" style="justify-content:flex-start;margin:1.75rem 0;">
          <span class="separator-line"></span>
          <span class="separator-diamond"></span>
        </div>
        <a href="/about" class="btn-primary-custom" data-i18n="home.learnMore">გაიგეთ მეტი უჯარმის შესახებ</a>
      </div>

      <div class="col-lg-6">
        <div class="about-visual">
          <!-- Replace with an actual photograph when available -->
          <div style="text-align:center;color:rgba(197,160,40,0.5);z-index:1;position:relative;">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 144" width="96" height="114" aria-hidden="true">
              <path d="M60 6 L114 30 L114 88 Q114 128 60 140 Q6 128 6 88 L6 30 Z"
                    fill="none" stroke="rgba(197,160,40,0.4)" stroke-width="2"/>
              <line x1="60" y1="35" x2="60" y2="112" stroke="rgba(197,160,40,0.35)" stroke-width="2.5"/>
              <line x1="22" y1="74" x2="98" y2="74" stroke="rgba(197,160,40,0.35)" stroke-width="2.5"/>
              <circle cx="60" cy="74" r="8" fill="none" stroke="rgba(197,160,40,0.45)" stroke-width="2"/>
              <circle cx="60" cy="74" r="3"  fill="rgba(197,160,40,0.55)"/>
            </svg>
            <p style="font-size:.75rem;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.35);margin-top:1rem;" data-i18n="home.villageNamePlaceholder">
              უჯარმის სოფელი
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     CONTACT CTA SECTION
════════════════════════════════════════════════════════ -->
<section class="contact-cta" aria-label="დაგვიკავშირდით — მოწოდება" data-i18n-aria-label="home.contactCTAAriaLabel">
  <div class="container" style="position:relative;z-index:1;">
    <div class="row justify-content-center">
      <div class="col-lg-7 col-md-9 text-center">
        <div class="section-label" style="justify-content:center;color:var(--gold-300);" data-i18n="home.contactCTALabel">
          გვიკავშირდებოდეთ
        </div>
        <h2 class="contact-cta-title" data-i18n="home.contactCTATitle">ადმინისტრაცია ღიაა თქვენთვის</h2>
        <p class="contact-cta-sub" data-i18n="home.contactCTASub">
          გაქვთ კითხვა, წინადადება ან ოფიციალური საკითხი? უჯარმის სოფლის ადმინისტრაცია ანგარიშვალდებულია თქვენს წინაშე და მზადაა გიპასუხოთ ყველა საკითხზე.
        </p>
        <a href="/contact" class="btn-gold" data-i18n="home.contactCTABtn">დაგვიკავშირდით</a>
      </div>
    </div>
  </div>
</section>
