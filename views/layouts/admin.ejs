<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Admin — Ujarma' %></title>
  <meta name="robots" content="noindex, nofollow" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
    crossorigin="anonymous" />

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

  <!-- Custom Styles -->
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body">

  <div class="admin-wrapper">

    <!-- ── Sidebar ─────────────────────────────── -->
    <aside class="admin-sidebar" id="adminSidebar">

      <div class="admin-logo">
        <div class="admin-logo-name">უჯარმა</div>
        <div class="admin-logo-label">ადმინისტრაციის პანელი</div>
      </div>

      <nav class="admin-nav">
        <div class="admin-nav-section">მთავარი</div>

        <a href="/admin/dashboard"
           class="admin-nav-link <%= currentPath === '/admin' || currentPath === '/admin/dashboard' ? 'active' : '' %>">
          <i class="bi bi-grid-1x2"></i>
          დასაბორდი
        </a>

        <div class="admin-nav-section" style="margin-top:1.25rem;">კონტენტი</div>

        <a href="/admin/news"
           class="admin-nav-link <%= currentPath.startsWith('/admin/news') ? 'active' : '' %>">
          <i class="bi bi-newspaper"></i>
          სიახლეები
        </a>

        <a href="/admin/attractions"
           class="admin-nav-link <%= currentPath.startsWith('/admin/attractions') ? 'active' : '' %>">
          <i class="bi bi-signpost-2"></i>
          ღირსშესანიშნაობები
        </a>

        <a href="/admin/gallery"
           class="admin-nav-link <%= currentPath.startsWith('/admin/gallery') ? 'active' : '' %>">
          <i class="bi bi-images"></i>
          გალერეა
        </a>

        <div class="admin-nav-section" style="margin-top:1.25rem;">საიტი</div>

        <a href="/" target="_blank" class="admin-nav-link">
          <i class="bi bi-box-arrow-up-right"></i>
          ვებსაიტის ნახვა
        </a>

      </nav>

      <div class="admin-sidebar-footer">
        <a href="/admin/logout" class="admin-logout-btn">
          <i class="bi bi-box-arrow-left"></i>
          გამოსვლა
        </a>
      </div>

    </aside>
    <!-- ── /Sidebar ────────────────────────────── -->

    <!-- ── Main Content ─────────────────────────── -->
    <div class="admin-main">

      <!-- Top Bar -->
      <header class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
          <!-- Mobile sidebar toggle -->
          <button id="adminSidebarToggle"
                  class="d-lg-none btn p-0 border-0"
                  style="background:none;color:var(--color-primary);font-size:1.25rem;">
            <i class="bi bi-list"></i>
          </button>
          <span class="admin-topbar-title">
            <%= typeof title !== 'undefined' ? title.replace(' — Ujarma Admin', '') : 'Admin' %>
          </span>
        </div>
        <div class="admin-topbar-user">
          <i class="bi bi-person-circle"></i>
          ადმინისტრატორი
        </div>
      </header>

      <!-- Page Content -->
      <div class="admin-content">
        <%- body %>
      </div>

    </div>
    <!-- ── /Main Content ──────────────────────── -->

  </div>

  <!-- Bootstrap JS -->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
    crossorigin="anonymous">
  </script>

  <!-- Custom JS -->
  <script src="/js/main.js"></script>

</body>
</html>
