<%# admin/news.ejs — Admin News Management -%>

<div class="admin-page-header">
  <h1 class="admin-page-title">სიახლეების მართვა</h1>
  <button class="btn-admin-add" disabled title="CRUD ოპერაციები მომავალი ფაზში განვითარდება">
    <i class="bi bi-plus-lg"></i> სტატიის დამატება
  </button>
</div>

<div class="admin-table-wrap">
  <div class="admin-table-header">
    <span class="admin-table-title">All Articles</span>
    <span style="font-size:.8125rem;color:var(--color-text-muted);">
      <%= articles.length %> article<%= articles.length !== 1 ? 's' : '' %>
    </span>
  </div>

  <% if (articles && articles.length > 0) { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Status</th>
          <th>Published</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% articles.forEach(function(article) { %>
          <tr>
            <td>
              <span style="font-weight:500;color:var(--color-primary);">
                <%= article.title %>
              </span>
            </td>
            <td>
              <span class="badge-published">Published</span>
            </td>
            <td style="color:var(--color-text-secondary);">
              <%= new Date(article.published_at).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %>
            </td>
            <td>
              <div style="display:flex;gap:.5rem;">
                <a href="/news/<%= article.slug %>"
                   target="_blank"
                   style="font-size:.75rem;color:var(--color-accent);font-weight:500;"
                   title="View on site">
                  <i class="bi bi-box-arrow-up-right"></i>
                </a>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <div class="empty-state" style="padding:4rem 2rem;">
      <div class="empty-state-icon"><i class="bi bi-newspaper"></i></div>
      <p>No articles have been published yet.</p>
      <p style="font-size:.8125rem;color:var(--color-text-muted);">
        Articles added through the admin interface will appear here.
      </p>
    </div>
  <% } %>
</div>

<!-- Implementation Notice -->
<div style="margin-top:1.5rem;padding:1.25rem 1.5rem;background:var(--gold-100);border:1px solid var(--gold-300);border-radius:var(--radius);border-left:3px solid var(--gold-500);">
  <p style="font-size:.875rem;color:var(--gold-700);margin:0;">
    <i class="bi bi-info-circle me-2"></i>
    <strong>Foundation Phase:</strong> Create, Edit, and Delete operations will be
    implemented in the next development phase.
  </p>
</div>
