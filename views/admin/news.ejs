<%# admin/news.ejs — სიახლეების სია -%>

<div class="admin-page-header">
  <h1 class="admin-page-title">სიახლეების მართვა</h1>
  <%# Desktop create button — hidden on mobile (FAB replaces it) %>
  <a href="/admin/news/create"
     class="admin-desktop-create-btn"
     style="display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1.125rem;background:var(--color-primary);color:var(--white);border:none;border-radius:var(--radius);font-size:.8125rem;font-weight:600;text-decoration:none;cursor:pointer;">
    <i data-lucide="plus" class="icon-inline"></i> სტატიის დამატება
  </a>
</div>

<!-- ── Flash Message ───────────────────────────────── -->
<% if (flash === 'created') { %>
  <div class="admin-flash-success">
    <i data-lucide="check-circle-2" class="icon-inline"></i>
    სტატია წარმატებით დაემატა.
  </div>
<% } else if (flash === 'updated') { %>
  <div class="admin-flash-success">
    <i data-lucide="check-circle-2" class="icon-inline"></i>
    სტატია წარმატებით განახლდა.
  </div>
<% } else if (flash === 'deleted') { %>
  <div class="admin-flash-success"
       style="background:#fff7ed;border-color:#fed7aa;border-left-color:#ea580c;color:#9a3412;">
    <i data-lucide="trash-2" class="icon-inline"></i>
    სტატია წაიშალა.
  </div>
<% } %>

<!-- ── Search & Filter ──────────────────────────────── -->
<div class="admin-table-wrap">
  <form method="GET" action="/admin/news" id="contentFilterForm">

    <!-- Desktop filter bar (hidden on mobile via CSS) -->
    <div class="admin-filters">
      <input class="admin-filter-input"
             type="text"
             name="search"
             id="filterSearchInput"
             value="<%= search %>"
             placeholder="სათაურით ძებნა…" />

      <select class="admin-filter-select" name="category" id="filterCategorySelect">
        <option value="">ყველა კატეგორია</option>
        <% categories.forEach(function(cat) { %>
          <option value="<%= cat.id %>"
            <%= categoryId == cat.id ? 'selected' : '' %>>
            <%= cat.name %>
          </option>
        <% }) %>
      </select>

      <button type="submit" class="admin-filter-btn">
        <i data-lucide="search" class="icon-inline"></i> ძებნა
      </button>

      <% if (search || categoryId) { %>
        <a href="/admin/news"
           style="font-size:.8125rem;color:var(--color-text-muted);text-decoration:none;">
          გასუფთავება
        </a>
      <% } %>

      <span style="margin-left:auto;font-size:.8125rem;color:var(--color-text-muted);">
        სულ: <%= total %> სტატია
      </span>
    </div>

    <!-- Mobile search bar -->
    <div class="admin-mobile-search-bar">
      <input type="text"
             class="admin-filter-input"
             id="mobileSearchInput"
             value="<%= search %>"
             placeholder="სათაურით ძებნა…"
             autocomplete="off" />
      <button type="button"
              class="admin-mobile-filter-toggle <%= categoryId ? 'has-filter' : '' %>"
              id="mobileFilterToggle"
              aria-label="ფილტრები">
        <i data-lucide="sliders-horizontal"></i>
        <% if (categoryId) { %><span class="admin-filter-active-dot"></span><% } %>
      </button>
      <button type="submit"
              class="admin-mobile-search-submit"
              aria-label="ძებნა">
        <i data-lucide="search"></i>
      </button>
    </div>
    <div class="admin-results-count">სულ: <%= total %> სტატია</div>

    <!-- Mobile filter bottom sheet -->
    <div class="admin-filter-sheet" id="mobileFilterSheet" aria-hidden="true">
      <div class="admin-filter-sheet-backdrop"></div>
      <div class="admin-filter-sheet-panel" role="dialog" aria-modal="true" aria-label="ფილტრები">
        <div class="admin-filter-sheet-handle"></div>
        <div class="admin-filter-sheet-header">
          <span class="admin-filter-sheet-title">ფილტრი</span>
          <button type="button" class="admin-filter-sheet-close-btn" aria-label="დახურვა">
            <i data-lucide="x"></i>
          </button>
        </div>
        <div class="admin-filter-sheet-body">
          <div class="admin-field">
            <label class="admin-label" for="mobileFilterCategory">კატეგორია</label>
            <select class="admin-select" id="mobileFilterCategory">
              <option value="">ყველა კატეგორია</option>
              <% categories.forEach(function(cat) { %>
                <option value="<%= cat.id %>"
                  <%= categoryId == cat.id ? 'selected' : '' %>>
                  <%= cat.name %>
                </option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="admin-filter-sheet-footer">
          <button type="button" class="btn-primary-custom" id="applyMobileFilters">
            <i data-lucide="check" class="icon-inline"></i> გამოყენება
          </button>
          <% if (categoryId) { %>
            <a href="/admin/news<%= search ? '?search=' + encodeURIComponent(search) : '' %>"
               class="admin-filter-clear-btn">გასუფთავება</a>
          <% } %>
        </div>
      </div>
    </div>

  </form>

  <!-- ── Table ──────────────────────────────────────── -->
  <% if (articles && articles.length > 0) { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>სათაური</th>
          <th>კატეგორია</th>
          <th>გამოქვეყნება</th>
          <th>სტატუსი</th>
          <th>მოქმედებები</th>
        </tr>
      </thead>
      <tbody>
        <% articles.forEach(function(article) { %>
          <tr>
            <%# td-title: always visible; contains mobile-meta strip %>
            <td class="td-title" data-label="სათაური">
              <div class="admin-cell-title" style="font-weight:500;color:var(--color-primary);max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                <%= article.title %>
              </div>
              <% if (article.is_featured) { %>
                <span style="font-size:.625rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--gold-700);background:var(--gold-100);padding:.15rem .5rem;border-radius:999px;margin-top:3px;display:inline-block;">
                  გამორჩეული
                </span>
              <% } %>
              <%# Mobile-only meta row (hidden on desktop via CSS) %>
              <div class="td-mobile-meta">
                <% if (article.is_published) { %>
                  <span class="badge-published">გამოქვეყნებული</span>
                <% } else { %>
                  <span class="badge-draft">მუსვარი</span>
                <% } %>
                <% if (article.category_name) { %>
                  <span class="meta-sep">·</span>
                  <span class="meta-text"><%= article.category_name %></span>
                <% } %>
                <span class="meta-sep">·</span>
                <span class="meta-text">
                  <%= new Date(article.published_at).toLocaleDateString('ka-GE', { day:'numeric', month:'short', year:'numeric' }) %>
                </span>
              </div>
            </td>
            <td data-label="კატეგორია" style="color:var(--color-text-secondary);font-size:.875rem;">
              <%= article.category_name || '—' %>
            </td>
            <td data-label="თარიზი" style="font-size:.8125rem;color:var(--color-text-secondary);">
              <%= new Date(article.published_at).toLocaleDateString('ka-GE', { day:'numeric', month:'short', year:'numeric' }) %>
            </td>
            <td data-label="სტატუსი">
              <% if (article.is_published) { %>
                <span class="badge-published">გამოქვეყნებული</span>
              <% } else { %>
                <span class="badge-draft">მუსვარი</span>
              <% } %>
            </td>
            <%# td-actions: always visible as card footer %>
            <td class="td-actions" data-label="">
              <div class="admin-card-actions">
                <a href="/admin/news/<%= article.id %>/edit"
                   class="admin-action-edit"
                   title="რედაქტირება">
                  <i data-lucide="pencil" class="icon-inline"></i>
                  <span class="admin-action-label">რედაქტირება</span>
                </a>
                <a href="/news/<%= article.slug %>"
                   target="_blank"
                   rel="noopener"
                   class="admin-action-view"
                   title="ვებსაიტზე ნახვა">
                  <i data-lucide="external-link" class="icon-inline"></i>
                </a>
                <button type="button"
                        class="btn-delete-trigger admin-action-delete"
                        data-id="<%= article.id %>"
                        data-title="<%= article.title.replace(/\"/g, '&quot;') %>"
                        title="წაშლა">
                  <i data-lucide="trash-2" class="icon-inline"></i>
                  <span class="admin-action-label">წაშლა</span>
                </button>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <% if (totalPages > 1) { %>
      <div class="admin-pagination">
        <% if (page > 1) { %>
          <a href="/admin/news?page=<%= page-1 %>&search=<%= encodeURIComponent(search) %>&category=<%= categoryId %>"
             class="admin-page-btn admin-page-prev">
            <i data-lucide="chevron-left" class="icon-inline"></i>
          </a>
        <% } else { %>
          <span class="admin-page-btn disabled admin-page-prev">
            <i data-lucide="chevron-left" class="icon-inline"></i>
          </span>
        <% } %>
        <% for (let p = 1; p <= totalPages; p++) { %>
          <a href="/admin/news?page=<%= p %>&search=<%= encodeURIComponent(search) %>&category=<%= categoryId %>"
             class="admin-page-btn admin-page-num <%= p === page ? 'active' : '' %>">
            <%= p %>
          </a>
        <% } %>
        <span class="admin-page-info"><%= page %> / <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a href="/admin/news?page=<%= page+1 %>&search=<%= encodeURIComponent(search) %>&category=<%= categoryId %>"
             class="admin-page-btn admin-page-next">
            <i data-lucide="chevron-right" class="icon-inline"></i>
          </a>
        <% } else { %>
          <span class="admin-page-btn disabled admin-page-next">
            <i data-lucide="chevron-right" class="icon-inline"></i>
          </span>
        <% } %>
      </div>
    <% } %>

  <% } else { %>
    <div class="empty-state" style="padding:4rem 2rem;">
      <div class="empty-state-icon"><i data-lucide="newspaper"></i></div>
      <p><% if (search || categoryId) { %>ფილტრის შედეგები ცარიელია.<% } else { %>სტატიები ჯერ არ დამატებულა.<% } %></p>
    </div>
  <% } %>
</div>

<!-- ── FAB (mobile only) ──────────────────────────────── -->
<a href="/admin/news/create" class="admin-fab" aria-label="სტატიის დამატება">
  <i data-lucide="plus"></i>
</a>

<!-- ── Delete Confirmation Modal ────────────────────── -->
<div class="admin-modal-overlay" id="deleteModal" role="dialog" aria-modal="true">
  <div class="admin-modal">
    <h2 class="admin-modal-title">სტატიის წაშლა</h2>
    <p class="admin-modal-body" id="deleteModalBody"></p>
    <div class="admin-modal-actions">
      <button type="button"
              onclick="closeDeleteModal()"
              class="admin-page-btn"
              style="padding:.625rem 1.25rem;">
        გაუქმება
      </button>
      <form id="deleteForm" method="POST" action="">
        <button type="submit"
                style="padding:.625rem 1.5rem;background:#dc2626;color:var(--white);border:none;border-radius:var(--radius);font-size:.8125rem;font-weight:600;cursor:pointer;">
          <i data-lucide="trash-2" class="icon-inline"></i> წაშლა
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  function openDeleteModal(id, title) {
    document.getElementById('deleteModalBody').textContent =
      'დარწმუნებული ხართ, რომ გსურთ სტატიის "' + title + '" წაშლა? ეს მოქმედება შეუქცევადია.';
    document.getElementById('deleteForm').action = '/admin/news/' + id + '/delete';
    document.getElementById('deleteModal').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeDeleteModal() {
    document.getElementById('deleteModal').classList.remove('open');
    document.body.style.overflow = '';
  }
  document.querySelectorAll('.btn-delete-trigger').forEach(function(btn) {
    btn.addEventListener('click', function() {
      openDeleteModal(this.dataset.id, this.dataset.title);
    });
  });
  document.getElementById('deleteModal').addEventListener('click', function(e) {
    if (e.target === this) closeDeleteModal();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeDeleteModal();
  });
</script>
