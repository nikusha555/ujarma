<%# admin/gallery-create.ejs — ფოტოს დამატება -%>

<div class="admin-page-header">
  <h1 class="admin-page-title">ფოტოს დამატება</h1>
  <a href="/admin/gallery" style="display:inline-flex;align-items:center;gap:.375rem;font-size:.8125rem;color:var(--color-text-secondary);text-decoration:none;">
    <i data-lucide="arrow-left" class="icon-inline"></i> გალერეაზე დაბრუნება
  </a>
</div>

<% if (errors && errors.length > 0) { %>
  <div class="admin-error-list"><ul><% errors.forEach(e => { %><li><i data-lucide="alert-circle" class="icon-inline"></i> <%= e %></li><% }) %></ul></div>
<% } %>

<form method="POST" action="/admin/gallery/create" enctype="multipart/form-data" novalidate>
  <div class="row g-4">

    <div class="col-lg-6">
      <div class="admin-form-card">
        <div class="admin-form-card-header"><i data-lucide="image" class="icon-inline"></i><span class="admin-form-card-title">სურათი</span></div>
        <div class="admin-form-card-body">
          <div class="admin-field">
            <label for="image" class="admin-label">სურათის ატვირთვა <span class="req">*</span></label>
            <input type="file" id="image" name="image" class="admin-input" accept="image/jpeg,image/jpg,image/png,image/webp" style="padding:.5rem;" required />
            <p class="admin-hint">JPG, PNG, WebP — მაქს. 5 MB</p>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="admin-form-card mb-4">
        <div class="admin-form-card-header"><i data-lucide="type" class="icon-inline"></i><span class="admin-form-card-title">ინფორმაცია</span></div>
        <div class="admin-form-card-body">
          <div class="admin-field">
            <label for="title" class="admin-label">სახელწოდება <span class="req">*</span></label>
            <input type="text" id="title" name="title" class="admin-input" value="<%= formData.title || '' %>" placeholder="ფოტოს სახელწოდება…" required />
          </div>
          <div class="admin-field">
            <label for="category_id" class="admin-label">კატეგორია</label>
            <select id="category_id" name="category_id" class="admin-select">
              <option value="">— არ არის არჩეული —</option>
              <% categories.forEach(function(cat) { %>
                <option value="<%= cat.id %>" <%= formData.category_id == cat.id ? 'selected' : '' %>><%= cat.name %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </div>

      <button type="submit" class="btn-primary-custom w-100 text-center" style="padding:.875rem;font-size:.875rem;width:100%;display:block;">
        <i data-lucide="save" class="icon-inline"></i> შენახვა
      </button>
    </div>

  </div>
</form>
