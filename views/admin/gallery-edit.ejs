<%# admin/gallery-edit.ejs — ფოტოს რედაქტირება -%>

<div class="admin-page-header">
  <h1 class="admin-page-title">ფოტოს რედაქტირება</h1>
  <a href="/admin/gallery" style="display:inline-flex;align-items:center;gap:.375rem;font-size:.8125rem;color:var(--color-text-secondary);text-decoration:none;">
    <i data-lucide="arrow-left" class="icon-inline"></i> გალერეაზე დაბრუნება
  </a>
</div>

<% if (errors && errors.length > 0) { %>
  <div class="admin-error-list"><ul><% errors.forEach(e => { %><li><i data-lucide="alert-circle" class="icon-inline"></i> <%= e %></li><% }) %></ul></div>
<% } %>

<form method="POST" action="/admin/gallery/<%= item.id %>/edit" enctype="multipart/form-data" novalidate>
  <div class="row g-4">

    <div class="col-lg-6">
      <div class="admin-form-card">
        <div class="admin-form-card-header"><i data-lucide="image" class="icon-inline"></i><span class="admin-form-card-title">სურათი</span></div>
        <div class="admin-form-card-body">
          <% if (item.image) { %>
            <div class="admin-image-preview mb-3"><img src="/uploads/gallery/<%= item.image %>" alt="<%= item.title %>" style="max-height:240px;width:auto;" /></div>
            <div class="admin-check-row mb-2"><input type="checkbox" id="remove_image" name="remove_image" /><label for="remove_image" style="color:#dc2626;">სურათის წაშლა</label></div>
          <% } %>
          <div class="admin-field">
            <label for="image" class="admin-label"><%= item.image ? 'ახალი სურათი (ჩასანაცვლებლად)' : 'სურათის ატვირთვა' %></label>
            <input type="file" id="image" name="image" class="admin-input" accept="image/jpeg,image/jpg,image/png,image/webp" style="padding:.5rem;" />
            <p class="admin-hint">JPG, PNG, WebP — მაქს. 5 MB</p>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="admin-form-card mb-4">
        <div class="admin-form-card-header"><i data-lucide="type" class="icon-inline"></i><span class="admin-form-card-title">ინფორმაცია</span></div>
        <div class="admin-form-card-body">
          <div class="admin-field">
            <label for="title" class="admin-label">სახელწოდება <span class="req">*</span></label>
            <input type="text" id="title" name="title" class="admin-input" value="<%= item.title || '' %>" required />
          </div>
          <div class="admin-field">
            <label for="category_id" class="admin-label">კატეგორია</label>
            <select id="category_id" name="category_id" class="admin-select">
              <option value="">— არ არის არჩეული —</option>
              <% categories.forEach(function(cat) { %>
                <option value="<%= cat.id %>" <%= item.category_id == cat.id ? 'selected' : '' %>><%= cat.name %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </div>

      <button type="submit" class="btn-primary-custom w-100 text-center" style="padding:.875rem;font-size:.875rem;width:100%;display:block;margin-bottom:.875rem;">
        <i data-lucide="save" class="icon-inline"></i> ცვლილებების შენახვა
      </button>
      <button type="button" class="btn-delete-trigger" data-id="<%= item.id %>" data-title="<%= item.title.replace(/\"/g,'&quot;') %>"
        style="width:100%;padding:.75rem;background:none;border:1.5px solid #fecaca;border-radius:var(--radius);color:#dc2626;font-size:.8125rem;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:.5rem;">
        <i data-lucide="trash-2" class="icon-inline"></i> ფოტოს წაშლა
      </button>
    </div>

  </div>
</form>

<div class="admin-modal-overlay" id="deleteModal" role="dialog" aria-modal="true">
  <div class="admin-modal">
    <h2 class="admin-modal-title">ფოტოს წაშლა</h2>
    <p class="admin-modal-body" id="deleteModalBody"></p>
    <div class="admin-modal-actions">
      <button type="button" onclick="closeDeleteModal()" class="admin-page-btn" style="padding:.625rem 1.25rem;">გაუქმება</button>
      <form id="deleteForm" method="POST" action="">
        <button type="submit" style="padding:.625rem 1.5rem;background:#dc2626;color:var(--white);border:none;border-radius:var(--radius);font-size:.8125rem;font-weight:600;cursor:pointer;"><i data-lucide="trash-2" class="icon-inline"></i> წაშლა</button>
      </form>
    </div>
  </div>
</div>
<script>
  function openDeleteModal(id, title) { document.getElementById('deleteModalBody').textContent = 'გსურთ "' + title + '" წაშლა?'; document.getElementById('deleteForm').action = '/admin/gallery/' + id + '/delete'; document.getElementById('deleteModal').classList.add('open'); document.body.style.overflow = 'hidden'; }
  function closeDeleteModal() { document.getElementById('deleteModal').classList.remove('open'); document.body.style.overflow = ''; }
  document.querySelectorAll('.btn-delete-trigger').forEach(b => b.addEventListener('click', () => openDeleteModal(b.dataset.id, b.dataset.title)));
  document.getElementById('deleteModal').addEventListener('click', e => { if (e.target === document.getElementById('deleteModal')) closeDeleteModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDeleteModal(); });
</script>
