<%# admin/gallery.ejs — Admin Gallery Management -%>

<div class="admin-page-header">
  <h1 class="admin-page-title">გალერეის მართვა</h1>
  <button class="btn-admin-add" disabled title="CRUD ოპერაციები მომავალი ფაზში განვითარდება">
    <i class="bi bi-upload"></i> ფოტოს ატვირთვა
  </button>
</div>

<% if (items && items.length > 0) { %>

  <!-- Image Grid View -->
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:1rem;margin-bottom:1.5rem;">
    <% items.forEach(function(item) { %>
      <div style="background:var(--white);border:1px solid var(--color-border);border-radius:var(--radius-md);overflow:hidden;">
        <div style="aspect-ratio:1;overflow:hidden;background:var(--gray-100);">
          <img src="/uploads/<%= item.image %>"
               alt="<%= item.title %>"
               loading="lazy"
               style="width:100%;height:100%;object-fit:cover;" />
        </div>
        <div style="padding:.75rem;">
          <p style="font-size:.8125rem;font-weight:500;color:var(--color-primary);margin-bottom:.25rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
            <%= item.title %>
          </p>
          <span style="font-size:.625rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--color-text-muted);">
            <%= item.category || 'General' %>
          </span>
        </div>
      </div>
    <% }) %>
  </div>

  <div style="padding:.875rem 1.25rem;background:var(--gray-50);border:1px solid var(--color-border);border-radius:var(--radius);font-size:.8125rem;color:var(--color-text-muted);">
    Showing <%= items.length %> image<%= items.length !== 1 ? 's' : '' %>
  </div>

<% } else { %>
  <div class="admin-table-wrap">
    <div class="empty-state" style="padding:4rem 2rem;">
      <div class="empty-state-icon"><i class="bi bi-images"></i></div>
      <p>No gallery images have been uploaded yet.</p>
    </div>
  </div>
<% } %>

<div style="margin-top:1.5rem;padding:1.25rem 1.5rem;background:var(--gold-100);border:1px solid var(--gold-300);border-radius:var(--radius);border-left:3px solid var(--gold-500);">
  <p style="font-size:.875rem;color:var(--gold-700);margin:0;">
    <i class="bi bi-info-circle me-2"></i>
    <strong>Foundation Phase:</strong> Image upload and management will be implemented in the next phase.
    Multer is already configured in <code>config/multer.js</code>.
  </p>
</div>
