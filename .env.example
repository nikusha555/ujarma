# =====================================================
# Ujarma Village Website — Environment Configuration
# =====================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ----- Application -----
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000

# ----- Database -----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=ujarma_db

# ----- Session -----
# Use a long, random string. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-secret-string-in-production

# ----- Admin Credentials -----
# Change these immediately before going to production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-immediately
